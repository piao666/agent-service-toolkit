{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Base Chunk Manifest Record",
  "type": "object",
  "required": [
    "chunk_id",
    "normalized_id",
    "doc_id",
    "source_id",
    "sample_id",
    "doc_type",
    "chunk_index",
    "chunk_sha256",
    "content_sha256",
    "content_preview",
    "metadata",
    "embedding_written",
    "chroma_written"
  ],
  "properties": {
    "chunk_id": { "type": "string" },
    "normalized_id": { "type": "string" },
    "doc_id": { "type": ["string", "null"] },
    "source_id": { "type": "string" },
    "sample_id": { "type": ["string", "null"] },
    "doc_type": { "type": "string" },
    "domain": { "type": ["string", "null"] },
    "title": { "type": "string" },
    "source_url": { "type": ["string", "null"] },
    "section_path": { "type": "array", "items": { "type": "string" } },
    "page_start": { "type": ["integer", "null"], "minimum": 1 },
    "page_end": { "type": ["integer", "null"], "minimum": 1 },
    "chunk_index": { "type": "integer", "minimum": 0 },
    "chunk_size": { "type": "integer", "minimum": 1 },
    "chunk_overlap": { "type": "integer", "minimum": 0 },
    "language": { "type": "string" },
    "chunk_chars": { "type": "integer", "minimum": 1 },
    "chunk_sha256": { "type": "string" },
    "content_sha256": { "type": "string" },
    "content_preview": { "type": "string" },
    "metadata": { "type": "object" },
    "embedding_provider": { "type": ["string", "null"] },
    "vector_store": { "type": ["string", "null"] },
    "collection_name": { "type": ["string", "null"] },
    "embedding_written": { "type": "boolean" },
    "chroma_written": { "type": "boolean" },
    "created_at": { "type": "string" }
  },
  "additionalProperties": true
}
