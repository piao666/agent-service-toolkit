{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Base Document Manifest Record",
  "type": "object",
  "required": [
    "doc_id",
    "source_id",
    "file_alias",
    "extension",
    "size_bytes",
    "sha256",
    "local_path_policy",
    "ingested",
    "embedding_written",
    "chroma_written"
  ],
  "properties": {
    "doc_id": { "type": "string" },
    "source_id": { "type": "string" },
    "source_type": { "type": "string" },
    "domain": { "type": "string" },
    "language": { "type": "string" },
    "format": { "type": "string" },
    "file_alias": { "type": "string" },
    "extension": { "type": "string" },
    "size_bytes": { "type": "integer", "minimum": 0 },
    "sha256": { "type": "string" },
    "original_file_name_hash": { "type": "string" },
    "local_path_policy": { "type": "string" },
    "local_root_alias": { "type": "string" },
    "paragraph_count": { "type": ["integer", "null"], "minimum": 0 },
    "page_count": { "type": ["integer", "null"], "minimum": 0 },
    "inspection_status": { "type": "string" },
    "inspection_error": { "type": ["string", "null"] },
    "license_status": { "type": "string" },
    "redistribution": { "type": "string" },
    "ingested": { "type": "boolean" },
    "embedding_written": { "type": "boolean" },
    "chroma_written": { "type": "boolean" },
    "updated_at": { "type": "string" }
  },
  "additionalProperties": true
}
